// Shared build settings for all targets. Never put secrets (tokens) here.
//
// Your own values go in Configs/Local.xcconfig (ignored by git), see
// Configs/Local.xcconfig.example. That file survives `xcodegen generate`.

// Bundle ID of the app. Must be unique for your Apple account.
LIMIETEN_BUNDLE_ID = com.example.limieten

// Your Apple team ID (Xcode > Settings > Accounts). Empty = choose in Xcode.
DEVELOPMENT_TEAM =

#include? "Local.xcconfig"
